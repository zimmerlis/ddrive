<ui:FluentWindow x:Class="dDrive.App.SettingsWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  Title="Settings"
                  Width="520"
                  Height="620"
                  MinWidth="460"
                  MinHeight="400"
                  WindowStartupLocation="CenterOwner"
                  ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="Settings" ShowMinimize="False" ShowMaximize="False" ShowClose="True" />
        <StackPanel Grid.Row="1" Margin="30,20,30,12">
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="Global settings" />
            <TextBlock Margin="0,4,0,16" Opacity="0.68" Text="Configure dDrive behavior and language." />
            <CheckBox x:Name="StartWithWindowsCheckBox" Margin="0,0,0,10" Content="Start with Windows" />
            <CheckBox x:Name="StartMinimizedCheckBox" Margin="0,0,0,10" Content="Start minimized" />
            <CheckBox x:Name="RcloneEnabledCheckBox" Margin="0,0,0,14"
                      Content="Enable Rclone support"
                      ToolTip="Enables Rclone mounts for WebDAV, FTP, SFTP and SMB" />
            <TextBlock Margin="0,0,0,6" Text="Language" />
            <ComboBox x:Name="LanguageComboBox" Height="36" Margin="0,0,0,12">
                <ComboBoxItem Tag="English" Content="English" />
                <ComboBoxItem Tag="German" Content="Deutsch" />
                <ComboBoxItem Tag="Mandarin-Chinese" Content="Mandarin-Chinesisch: 汉语 (Hànyǔ) / 中文 (Zhōngwén)" />
                <ComboBoxItem Tag="Hindi" Content="Hindi: हिन्दी (Hindi)" />
                <ComboBoxItem Tag="Spanish" Content="Spanisch: Español (Castellano)" />
                <ComboBoxItem Tag="French" Content="Französisch: Français" />
            </ComboBox>
            <TextBlock Margin="0,0,0,6" Text="Color scheme" />
            <ComboBox x:Name="ColorSchemeComboBox" Height="36" Margin="0,0,0,12">
                <ComboBoxItem Tag="ocean" Content="Ozean" />
                <ComboBoxItem Tag="forest" Content="Wald" />
                <ComboBoxItem Tag="graphite" Content="Graphit" />
            </ComboBox>
            <TextBlock Margin="0,0,0,6" Text="Default website popup size (width × height)" />
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PopupWidthTextBox" Height="36" Grid.Column="0" VerticalContentAlignment="Center" ToolTip="Width in pixels (300–2000)" />
                <TextBox x:Name="PopupHeightTextBox" Height="36" Grid.Column="2" VerticalContentAlignment="Center" ToolTip="Height in pixels (360–2000)" />
            </Grid>
            <TextBlock Margin="0,0,0,6" Text="Default website popup position" />
            <ComboBox x:Name="PopupPositionComboBox" Height="36">
                <ComboBoxItem Tag="bottomright" Content="Bottom right, above the taskbar" />
                <ComboBoxItem Tag="center" Content="Center of the screen" />
            </ComboBox>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="30,0,30,16">
            <ui:Button Width="100" Height="36" Margin="0,0,8,0" Appearance="Secondary" Content="Cancel" IsCancel="True" />
            <ui:Button Width="100" Height="36" Appearance="Primary" Content="Save" IsDefault="True" Click="Save_Click" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
