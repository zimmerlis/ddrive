<ui:FluentWindow x:Class="dDrive.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
                 ExtendsContentIntoTitleBar="True"
                 Title="dDrive"
                 Width="1120"
                 Height="720"
                 MinWidth="900"
                 MinHeight="560"
                 WindowStartupLocation="CenterScreen"
                 Closing="Window_Closing"
                 Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="" ShowMinimize="True" ShowMaximize="True" ShowClose="True">
        </ui:TitleBar>
        <Grid Grid.Row="1" Margin="28,0,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Height="84" Margin="0,0,0,20" Padding="1" CornerRadius="10"
                BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <Grid>
                <Border CornerRadius="9" Background="{DynamicResource SystemAccentColorSecondaryBrush}" Opacity="0.12" />
                <Grid Margin="18,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <svg:SvgViewbox Width="64" Height="64"
                              Source="pack://application:,,,/dDrive.App;component/Assets/dDrive.svg"
                              Stretch="Uniform"
                              AutomationProperties.Name="dDrive-Appsymbol" />
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Netzwerkspeicher" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Margin="0,2,0,0" Opacity="0.68" Text="WebDAV · FTP" />
                    </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Appearance="Secondary" Height="36" Margin="0,0,8,0"
                           Content="Importieren" Icon="{ui:SymbolIcon Symbol=ArrowUpload24}"
                           ToolTip="Konfiguration importieren" Click="ImportConfiguration_Click" />
                <ui:Button Appearance="Secondary" Height="36" Margin="0,0,8,0"
                           Content="Exportieren" Icon="{ui:SymbolIcon Symbol=ArrowDownload24}"
                           ToolTip="Konfiguration ohne Zugangsdaten exportieren" Click="ExportConfiguration_Click" />
                <ui:Button Appearance="Secondary" Height="36" Margin="0,0,12,0"
                           Icon="{ui:SymbolIcon Symbol=DocumentText20}"
                           ToolTip="Diagnoseprotokoll öffnen" AutomationProperties.Name="Diagnoseprotokoll öffnen"
                           Click="OpenLogs_Click" />
                <ui:Button x:Name="ThemeButton" Appearance="Secondary" Width="36" Height="36"
                           Icon="{ui:SymbolIcon Symbol=WeatherMoon20}"
                           ToolTip="Design wechseln" AutomationProperties.Name="Design wechseln"
                           Click="ThemeButton_Click" />
                <ui:Button Appearance="Secondary" Width="36" Height="36" Margin="8,0,0,0"
                           Icon="{ui:SymbolIcon Symbol=Settings20}"
                           ToolTip="Einstellungen" AutomationProperties.Name="Einstellungen"
                           Click="SettingsButton_Click" />
                <ui:Button Appearance="Secondary" Width="36" Height="36" Margin="8,0,0,0"
                           Icon="{ui:SymbolIcon Symbol=QuestionCircle24}"
                           ToolTip="Über dDrive" AutomationProperties.Name="Über dDrive"
                           Click="AboutButton_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Verbindungen" FontSize="19" FontWeight="SemiBold" />
                <TextBlock x:Name="ConnectionCountText" Margin="0,3,0,0" Opacity="0.68" Text="0 Speicherorte" />
            </StackPanel>
            <ui:Button Grid.Column="1" Height="38" Appearance="Primary"
                       Content="Neue Verbindung" Icon="{ui:SymbolIcon Symbol=Add24}"
                       Click="AddConnection_Click" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox x:Name="SearchBox" Height="36" PlaceholderText="Verbindungen suchen"
                            TextChanged="SearchBox_TextChanged">
                    <ui:TextBox.Icon>
                        <ui:SymbolIcon Symbol="Search20" />
                    </ui:TextBox.Icon>
                </ui:TextBox>
            </Grid>

            <Border Grid.Row="1" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <ui:DataGrid x:Name="ConnectionsGrid" AutoGenerateColumns="False"
                             CanUserAddRows="False" IsReadOnly="True"
                             SelectionMode="Single" SelectionUnit="FullRow"
                             HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                             RowHeight="48" SelectionChanged="ConnectionsGrid_SelectionChanged">
                    <ui:DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.25*" />
                        <DataGridTextColumn Header="Protokoll" Binding="{Binding Protocol}" Width="110" />
                        <DataGridTextColumn Header="Server" Binding="{Binding Host}" Width="1.7*" />
                        <DataGridTextColumn Header="Remote-Pfad" Binding="{Binding RemotePath}" Width="1.15*" />
                        <DataGridTextColumn Header="Laufwerk" Binding="{Binding DriveLetter, StringFormat={}{0}:}" Width="80" />
                        <DataGridTemplateColumn Header="Status" Width="125">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </ui:DataGrid.Columns>
                </ui:DataGrid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Margin="0,14,0,0" Padding="1" CornerRadius="10"
                BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <Grid>
                <Border CornerRadius="9" Background="{DynamicResource SystemAccentColorSecondaryBrush}" Opacity="0.09" />
                <Grid Margin="12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" Opacity="0.82" Text="Bereit" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button x:Name="ConnectButton" Height="36" Margin="0,0,8,0"
                           Appearance="Primary" Content="Verbinden"
                           Icon="{ui:SymbolIcon Symbol=PlugConnected24}"
                           Click="MountConnection_Click" IsEnabled="False" />
                <ui:Button x:Name="DisconnectButton" Height="36" Margin="0,0,8,0"
                           Appearance="Secondary" Content="Trennen"
                           Icon="{ui:SymbolIcon Symbol=PlugDisconnected20}"
                           Click="UnmountConnection_Click" IsEnabled="False" />
                <ui:Button x:Name="EditButton" Height="36" Margin="0,0,8,0"
                           Appearance="Secondary" Content="Bearbeiten"
                           Icon="{ui:SymbolIcon Symbol=Edit20}"
                           Click="EditConnection_Click" IsEnabled="False" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
