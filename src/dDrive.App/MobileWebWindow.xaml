<Window x:Class="dDrive.App.MobileWebWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="dDrive Webansicht (Mobil)"
        Width="600" Height="760" MinWidth="300" MinHeight="360"
        WindowStartupLocation="Manual">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Margin="8" LastChildFill="True">
            <Button x:Name="OpenInBrowserButton" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="12,4"
                    Content="Im Browser öffnen" Click="OpenInBrowserButton_Click" />
            <Image x:Name="HeaderIcon" Width="16" Height="16" Margin="0,0,8,0" Visibility="Collapsed" VerticalAlignment="Center" />
            <TextBlock x:Name="AddressText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <wv2:WebView2 x:Name="Browser" Grid.Row="1" />
    </Grid>
</Window>
