<ui:FluentWindow x:Class="dDrive.App.AboutWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Über dDrive"
                 Width="520"
                 Height="720"
                 MinWidth="460"
                 MinHeight="600"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Über dDrive" ShowMinimize="False" ShowMaximize="False" ShowClose="True" />

        <Grid Grid.Row="1" Margin="30,24,30,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

        <StackPanel HorizontalAlignment="Center">
            <svg:SvgViewbox xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
                           Width="88"
                           Height="88"
                           Source="pack://application:,,,/dDrive.App;component/Assets/dDrive.svg"
                           Stretch="Uniform"
                           AutomationProperties.Name="dDrive-Appsymbol" />
            <TextBlock Margin="0,14,0,0"
                       HorizontalAlignment="Center"
                       FontSize="26"
                       FontWeight="SemiBold"
                       Text="dDrive" />
            <TextBlock Margin="0,4,0,0"
                       HorizontalAlignment="Center"
                       Opacity="0.68"
                       Text="Cloud Netzwerklaufwerk für Windows" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,26,0,0" HorizontalAlignment="Center">
            <TextBlock HorizontalAlignment="Center" TextAlignment="Center"
                       Text="dDrive verbindet deine Netzwerkdienste als Laufwerke in Windows." TextWrapping="Wrap" />
            <TextBlock Margin="0,7,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                       Text="WebDAV kann nativ genutzt werden; Rclone erweitert die unterstützten Protokolle." TextWrapping="Wrap" />
            <TextBlock Margin="0,7,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                       Text="Zugangsdaten werden im Windows Credential Manager gespeichert." TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,44,0,24" HorizontalAlignment="Center" VerticalAlignment="Top">
            <Border Width="112" Height="112" Background="White" Padding="8" HorizontalAlignment="Center">
                <Image x:Name="QrCodeImage" Stretch="Uniform" SnapsToDevicePixels="True" />
            </Border>
            <TextBlock Margin="0,12,0,0"
                       HorizontalAlignment="Center"
                       Opacity="0.68"
                       Text="Unterstütze dDrive mit Buy Me a Coffee" />
        </StackPanel>

        <StackPanel Grid.Row="4" Width="300" HorizontalAlignment="Center">
            <ui:Button Width="230" HorizontalAlignment="Center"
                       Height="46"
                       Background="#FFDD00"
                       Foreground="#000000"
                       BorderBrush="#000000"
                       BorderThickness="1"
                       Content="Buy Me a Coffee"
                       ToolTip="Open Buy Me a Coffee"
                       Click="SupportLink_Click" />
            <CheckBox x:Name="DonatedCheckBox" HorizontalAlignment="Center" Margin="0,12,0,0"
                      Checked="DonatedCheckBox_Changed"
                    Unchecked="DonatedCheckBox_Changed">
                <TextBlock MaxWidth="340" TextWrapping="Wrap"
                       Text="Ich habe gespendet (Dialog beim Start nicht mehr anzeigen)" />
            </CheckBox>
            <ui:Button Width="230" HorizontalAlignment="Center" HorizontalContentAlignment="Center" Margin="0,10,0,0" Padding="0" Background="Transparent" BorderThickness="0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Content="https://buymeacoffee.com/oxekklfcg"
                       ToolTip="Open Buy Me a Coffee link"
                       Click="BuyMeACoffeeLink_Click" />
            <ui:Button Width="230" HorizontalAlignment="Center" HorizontalContentAlignment="Center" Margin="0,8,0,0" Padding="0" Background="Transparent" BorderThickness="0"
                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                       Content="Support and Ideas"
                       ToolTip="Open GitHub support and ideas"
                       Click="GitHubSupport_Click" />
            <ui:Button Width="230" HorizontalAlignment="Center" HorizontalContentAlignment="Center" Margin="0,4,0,0" Padding="0" Background="Transparent" BorderThickness="0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Content="© René Zimmerli"
                       ToolTip="Open René Zimmerli on GitHub"
                       Click="GitHubAuthor_Click" />
        </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
