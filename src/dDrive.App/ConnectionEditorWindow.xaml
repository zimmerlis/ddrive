<ui:FluentWindow x:Class="dDrive.App.ConnectionEditorWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Verbindung"
                 Width="620"
                 Height="720"
                 MinWidth="540"
                 MinHeight="620"
                 ResizeMode="CanResizeWithGrip"
                WindowStartupLocation="CenterOwner">
    <Grid Margin="28,24,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,22">
            <TextBlock x:Name="DialogTitle" FontSize="22" FontWeight="SemiBold" Text="Neue Verbindung" />
            <TextBlock Margin="0,5,0,0" Opacity="0.68" Text="Zugangsdaten werden geschützt im Windows Credential Manager gespeichert." />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="58" />
                    <RowDefinition Height="58" />
                    <RowDefinition Height="58" />
                    <RowDefinition Height="58" />
                    <RowDefinition Height="58" />
                    <RowDefinition Height="58" />
                    <RowDefinition Height="58" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock VerticalAlignment="Center" Text="Anzeigename" />
                <ui:TextBox x:Name="NameTextBox" Grid.Column="1" Margin="0,7" />

                <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Protokoll" />
                <ComboBox x:Name="ProtocolComboBox" Grid.Row="1" Grid.Column="1" Margin="0,7"
                          SelectionChanged="ProtocolComboBox_SelectionChanged">
                    <ComboBoxItem Content="WebDAV" />
                    <ComboBoxItem Content="FTP" />
                    <ComboBoxItem x:Name="SftpProtocolItem" Content="SFTP" />
                    <ComboBoxItem x:Name="SmbProtocolItem" Content="SMB" />
                </ComboBox>

                <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Serveradresse" />
                <ui:TextBox x:Name="HostTextBox" Grid.Row="2" Grid.Column="1" Margin="0,7"
                            PlaceholderText="https://" />

                <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Port" />
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,7">
                    <ui:TextBox x:Name="PortTextBox" Width="120" HorizontalAlignment="Left" />
                    <CheckBox x:Name="SynologyNasCheckBox" Margin="14,0,0,0" VerticalAlignment="Center"
                              Content="Synology NAS" Visibility="Collapsed"
                              Checked="SynologyNasCheckBox_Changed" Unchecked="SynologyNasCheckBox_Changed" />
                </StackPanel>

                <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="Remote-Pfad" />
                <ui:TextBox x:Name="RemotePathTextBox" Grid.Row="4" Grid.Column="1" Margin="0,7" />

                <TextBlock Grid.Row="5" VerticalAlignment="Center" Text="Laufwerk" />
                <ui:TextBox x:Name="DriveLetterTextBox" Grid.Row="5" Grid.Column="1" Width="76" HorizontalAlignment="Left" Margin="0,7" MaxLength="1" />

                <TextBlock Grid.Row="6" VerticalAlignment="Center" Text="Benutzername" />
                <ui:TextBox x:Name="UsernameTextBox" Grid.Row="6" Grid.Column="1" Margin="0,7" />

                <TextBlock Grid.Row="7" Margin="0,14,0,0" VerticalAlignment="Top" Text="Passwort" />
                <StackPanel Grid.Row="7" Grid.Column="1" Margin="0,10,0,8">
                    <PasswordBox x:Name="PasswordBox" MaxLength="1280" />
                    <TextBlock Margin="0,6,0,0" FontSize="12" Opacity="0.68"
                               Text="Passwort eingeben, um es im Windows Credential Manager zu setzen" />
                </StackPanel>

                <CheckBox x:Name="RemovePasswordCheckBox" Grid.Row="8" Grid.Column="1" Margin="0,6"
                          Content="Gespeichertes Passwort entfernen" />
                <Separator Grid.Row="9" Grid.ColumnSpan="2" Margin="0,14" />
                <CheckBox x:Name="ReadOnlyCheckBox" Grid.Row="10" Grid.Column="1" Margin="0,5"
                          Content="Schreibgeschützt" />
                <StackPanel Grid.Row="11" Grid.Column="1" Margin="0,4,0,14">
                    <CheckBox x:Name="AutoMountCheckBox" Margin="0,5" Content="Beim Windows-Start verbinden" />
                    <CheckBox x:Name="VerifyTlsCheckBox" Margin="0,5" Content="TLS-Zertifikat prüfen" />
                    <CheckBox x:Name="UseTlsCheckBox" Margin="0,5" Content="TLS verwenden (HTTPS/FTPS)" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:Button Height="36" Appearance="Secondary"
                       Content="Verbindung testen" Icon="{ui:SymbolIcon Symbol=PlugConnected20}"
                       Click="TestConnection_Click" />
            <ui:Button x:Name="DeleteConnectionButton" Grid.Column="1" Height="36" Margin="0,0,8,0"
                       Appearance="Danger" Content="Verbindung löschen"
                       Icon="{ui:SymbolIcon Symbol=Delete20}"
                       Visibility="Collapsed" Click="DeleteConnection_Click" />
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <ui:Button MinWidth="100" Height="36" Margin="8,0,0,0"
                           Appearance="Secondary" Content="Abbrechen" IsCancel="True" />
                <ui:Button MinWidth="110" Height="36" Margin="8,0,0,0"
                           Appearance="Primary" Content="Speichern"
                           Icon="{ui:SymbolIcon Symbol=Save20}"
                           IsDefault="True" Click="Save_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
